// Prisma Schema Configuration
datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                   String    @id @default(uuid())
  name                 String
  email                String    @unique
  password             String
  phone                String?
  role                 String    @default("ADMIN") // "ADMIN", "REPORTER"
  status               String    @default("APPROVED") // "PENDING", "APPROVED", "REJECTED", "SUSPENDED"
  city                 String?
  district             String?
  state                String?
  bio                  String?   @db.Text
  profileImage         String?   @db.LongText
  idProofUrl           String?   @db.LongText // Mandatory Aadhaar or Press Card
  idProofType          String?   // "AADHAAR", "PRESS_ID", "VOTER_ID"
  idProofNumber        String?
  rejectionReason      String?   @db.Text
  preferredCategories  String?   // Comma-separated or JSON string
  resetPasswordToken   String?
  resetPasswordExpires DateTime?
  articles             Article[] @relation("ReporterArticles")
  deletedAt            DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([role])
  @@index([status])
  @@map("users")
}

model State {
  id        String    @id @default(uuid())
  name      String    // e.g. "बिहार", "उत्तर प्रदेश", "दिल्ली-एनसीआर"
  slug      String    @unique // e.g. "bihar", "uttar-pradesh", "delhi-ncr"
  order     Int       @default(0) // Mega-Menu display order
  active    Boolean   @default(true) // Enable/Disable state toggle
  editions  Edition[] // One-to-Many relation with Edition
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("states")
}

model Edition {
  id        String       @id @default(uuid())
  stateId   String?      // Foreign Key pointing to State
  state     State?       @relation(fields: [stateId], references: [id], onDelete: Cascade)
  name      String       // Full name, e.g. "पटना (मुख्य)", "दिल्ली एनसीआर"
  city      String       // City identifier, e.g. "पटना", "दिल्ली NCR"
  title     String?      // Masthead Title, e.g. "अपना पटना"
  tag       String?      // Edition badge, e.g. "बिहार मुख्य संस्करण"
  slug      String       @unique // e.g. "patna-main"
  code      String?      // e.g. "PAT_MAIN"
  order     Int          @default(0)
  isActive  Boolean      @default(true)
  issues    PaperIssue[]
  deletedAt DateTime?    // Soft Delete support
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([stateId])
  @@map("editions")
}

model PaperIssue {
  id               String      @id @default(uuid())
  editionId        String      // Relation FK to Edition
  edition          Edition     @relation(fields: [editionId], references: [id], onDelete: Cascade)
  publishDate      DateTime    // Publication Date (e.g. 2026-09-24)
  status           String      @default("DRAFT") // DRAFT or PUBLISHED
  totalPages       Int         @default(1)
  broadsheetPdfUrl String?
  pages            PaperPage[]
  deletedAt        DateTime?   // Soft Delete support
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@unique([editionId, publishDate])
  @@map("paper_issues")
}

model PaperPage {
  id           String      @id @default(uuid())
  paperIssueId String
  paperIssue   PaperIssue  @relation(fields: [paperIssueId], references: [id], onDelete: Cascade)
  pageNumber   Int         // 1 to 16
  title        String      // e.g. "Lead Cover", "City / State"
  templateKey  String      @default("layout_1")
  pdfUrl       String?
  pageImage    String?
  slots        PaperSlot[]
  deletedAt    DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([paperIssueId, pageNumber])
  @@map("paper_pages")
}

model PaperSlot {
  id                  String    @id @default(uuid())
  pageId              String
  page                PaperPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  slotIndex           Int
  x                   Int       @default(16)
  y                   Int       @default(115)
  width               Int       @default(400)
  height              Int       @default(250)
  headline            String    @db.Text
  subHeadline         String?   @db.Text
  categoryTag         String?
  contentText         String?   @db.LongText
  imageUrl            String?   @db.LongText
  imageAlign          String    @default("CENTER")
  imageWidth          Int?
  imageHeight         Int?
  imgPxX              Int?
  imgPxY              Int?
  headlineFontSize    Int?      @default(22)
  subHeadlineFontSize Int?      @default(18)
  bodyFontSize        Int?      @default(14)
  headlineColor       String?   @default("#111827")
  subHeadlineColor    String?   @default("#ba1228")
  bodyTextColor       String?   @default("#1f2937")
  colSpan             Int       @default(8)
  rowSpan             String    @default("auto")
  forceRowBreak       Boolean   @default(false)
  columnCount         Int?      @default(1)
  showColumnDividers  Boolean?  @default(false)
  columnDividerColor  String?   @default("#cbd5e1")
  kickerColor         String?   @default("#b91c1c")
  kickerTag           String?   @db.Text
  subStories          String?   @db.LongText
  highlightBox        String?   @db.Text
  bulletPoints        String?   @db.Text
  photoCaption        String?   @db.Text
  isAd                Boolean   @default(false)
  deletedAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@map("paper_slots")
}


model Article {
  id              String    @id @default(uuid())
  title           String    @db.Text
  slug            String    @unique
  subHeadline     String?   @db.Text
  content         String    @db.LongText
  category        String
  subCategory     String?
  featuredImage   String?   @db.LongText
  imageCaption    String?   @db.Text
  authorName      String    @default("News Desk")
  authorAvatar    String?
  bulletPoints    String?   @db.Text
  tags            String?   @db.Text
  isLeadStory     Boolean   @default(false)
  isTrending      Boolean   @default(false)
  status          String    @default("PUBLISHED")
  viewsCount      Int       @default(0)
  likesCount      Int       @default(0)
  readTimeMinutes Int       @default(3)
  metaTitle       String?   @db.Text
  metaDescription String?   @db.Text
  metaKeywords    String?   @db.Text
  canonicalUrl    String?   @db.Text
  isIndexed       Boolean   @default(true)
  reporterId      String?
  reporter        User?     @relation("ReporterArticles", fields: [reporterId], references: [id], onDelete: SetNull)
  adminFeedback   String?   @db.Text
  submittedAt     DateTime?
  reviewedAt      DateTime?
  reviewedBy      String?
  publishedAt     DateTime  @default(now())
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([category])
  @@index([status])
  @@index([reporterId])
  @@index([deletedAt])
  @@map("articles")
}


model Video {
  id              String    @id @default(uuid())
  title           String    @db.Text
  slug            String    @unique
  description     String?   @db.LongText
  videoType       String    @default("URL") // "URL" or "UPLOAD"
  videoUrl        String    @db.LongText
  youtubeId       String?
  thumbnailUrl    String?   @db.LongText
  duration        String    @default("00:00")
  durationSeconds Int?      @default(0)
  category        String    @default("news")
  subCategory     String?
  badge           String?
  location        String?
  reporterName    String    @default("News Desk")
  metaTitle       String?   @db.Text
  metaDescription String?   @db.Text
  tags            String?   @db.Text
  isFeaturedHero  Boolean   @default(false)
  isTrending      Boolean   @default(false)
  status          String    @default("PUBLISHED")
  viewsCount      Int       @default(0)
  likesCount      Int       @default(0)
  publishedAt     DateTime  @default(now())
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([category])
  @@index([status])
  @@index([isTrending])
  @@index([isFeaturedHero])
  @@index([deletedAt])
  @@map("videos")
}

model Horoscope {
  id              String   @id @default(uuid())
  sign            String
  signName        String
  hindiName       String?
  dateRange       String?
  period          String   @default("DAILY")
  luckyColour     String?
  luckyGemstone   String?
  luckyDay        String?
  luckyNumber     String?
  rulingPlanet    String?
  compatibleSign  String?
  prediction      String   @db.LongText
  remedy          String?  @db.Text
  date            String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([sign, period])
  @@index([sign])
  @@index([period])
  @@map("horoscopes")
}


model WeatherState {
  id        String        @id @default(uuid())
  name      String
  slug      String        @unique
  order     Int           @default(0)
  active    Boolean       @default(true)
  cities    WeatherCity[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@map("weather_states")
}

model WeatherCity {
  id           String       @id @default(uuid())
  stateId      String
  state        WeatherState @relation(fields: [stateId], references: [id], onDelete: Cascade)
  name         String
  slug         String       @unique
  latitude     Float
  longitude    Float
  monumentIcon String?      @db.Text
  isMainCity   Boolean      @default(false)
  order        Int          @default(0)
  active       Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([stateId])
  @@index([isMainCity])
  @@map("weather_cities")
}

model Category {
  id         String   @id @default(uuid())
  name       String   @unique
  slug       String   @unique
  order      Int      @default(0)
  isActive   Boolean  @default(true)
  showOnHome Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("categories")
}

model Advertisement {
  id          String    @id @default(uuid())
  title       String
  slot        String    // HOMEPAGE_TOP, ARTICLE_INLINE, ARTICLE_SIDEBAR
  type        String    @default("IMAGE") // IMAGE, SCRIPT
  imageUrl    String?   @db.Text
  targetUrl   String?   @db.Text
  scriptCode  String?   @db.Text
  startDate   DateTime?
  endDate     DateTime?
  isActive    Boolean   @default(true)
  viewsCount  Int       @default(0)
  clicksCount Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([slot, isActive])
  @@map("advertisements")
}


model AiSystemSetting {
  id                    String   @id @default(uuid())
  activeProvider        String   @default("gemini")
  enabled               Boolean  @default(true)
  temperature           Float    @default(0.7)
  maxTokens             Int      @default(4096)
  topP                  Float    @default(0.95)
  languageOverride      String   @default("hi")
  customWelcomeGreeting String?  @db.Text
  updatedAt             DateTime @updatedAt

  @@map("ai_system_settings")
}

model AiProviderConfig {
  id               String    @id @default(uuid())
  provider         String    @unique
  encryptedApiKey  String?   @db.Text
  selectedModel    String?
  cachedModels     String?   @db.LongText
  isVerified       Boolean   @default(false)
  lastTestedAt     DateTime?
  lastLatencyMs    Int?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@map("ai_provider_configs")
}


model AiDailyUsage {
  id               String   @id @default(uuid())
  provider         String
  date             String
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  totalTokens      Int      @default(0)
  requestCount     Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([provider, date])
  @@index([date])
  @@map("ai_daily_usages")
}

// -------------------------------------------------------------
// AI E-PAPER AUTOMATION & SCHEDULER MODELS
// -------------------------------------------------------------

model EpaperAutomationConfig {
  id               String                 @id @default(uuid())
  editionSlug      String                 @unique @default("patna-main")
  isEnabled        Boolean                @default(false)
  scheduleTime     String                 @default("05:00") // 24-hr format (05:00 AM)
  timezone         String                 @default("Asia/Kolkata")
  targetCity       String                 @default("पटना")
  totalPages       Int                    @default(8)
  autoPublish      Boolean                @default(false) // False = Hybrid (Admin Review Required)
  blueprints       EpaperPageBlueprint[]
  jobs             EpaperScheduleJobLog[]
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  @@map("epaper_automation_configs")
}

model EpaperPageBlueprint {
  id          String                 @id @default(uuid())
  configId    String
  config      EpaperAutomationConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
  pageNumber  Int                    // 1, 2, 3... up to 16
  pageTitle   String                 // e.g. "मुख्य पृष्ठ", "बिहार और पटना", "खेल जगत"
  headerType  String                 @default("folio") // "grand", "folio", "minimal"
  targetTopic String                 // e.g. "पटना और बिहार के प्रमुख प्रशासनिक व विकास कार्य"
  slotCount   Int                    @default(7) // 3 to 10 slots
  order       Int                    @default(0)
  isActive    Boolean                @default(true)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  @@unique([configId, pageNumber])
  @@index([configId])
  @@map("epaper_page_blueprints")
}

model EpaperScheduleJobLog {
  id              String                  @id @default(uuid())
  configId        String?
  config          EpaperAutomationConfig? @relation(fields: [configId], references: [id], onDelete: SetNull)
  editionSlug     String
  targetDate      String                  // "YYYY-MM-DD"
  status          String                  @default("SCHEDULED") // "SCHEDULED", "GENERATING", "AWAITING_APPROVAL", "PUBLISHED", "FAILED"
  pagesGenerated  Int                     @default(0)
  totalPages      Int                     @default(0)
  errorMessage    String?                 @db.Text
  executionLog    String?                 @db.LongText
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  @@index([editionSlug, targetDate])
  @@map("epaper_schedule_job_logs")
}
